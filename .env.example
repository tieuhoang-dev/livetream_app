DATABASE_URL= database connection string for MySQL
MONGO_URI= MongoDB connection string
JWT_SECRET= Secret key for JWT authentication
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT= Port number for SMTP server
SMTP_USER=  SMTP username for sending emails
SMTP_PASS= SMTP password for sending emails
FROM_EMAIL= Email address used as the sender for outgoing emails
BREVO_API_KEY= API key for Brevo email service
REDIS_ADDR= Address of the Redis server
REDIS_PASSWORD= Password for the Redis server (if required)

# Optional video streaming. Leave all four blank to disable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional internal HTTP(S) origin for the room API when it differs from LIVEKIT_URL.
LIVEKIT_API_URL=
