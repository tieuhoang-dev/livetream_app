DATABASE_URL= database connection string for MySQL
MONGO_URI= MongoDB connection string
JWT_SECRET= Secret key for JWT authentication
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT= Port number for SMTP server
SMTP_USER=  SMTP username for sending emails
SMTP_PASS= SMTP password for sending emails
FROM_EMAIL= Email address used as the sender for outgoing emails
BREVO_API_KEY= API key for Brevo email service
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Optional LiveKit Cloud video. Set URL/key/secret from your Cloud project.
# Leave all four blank to disable video; the dev launcher does not set defaults.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Leave blank for Cloud: the backend derives HTTPS from LIVEKIT_URL (wss://...).
# Only set an HTTP(S) origin here if your room API uses a different address.
LIVEKIT_API_URL=

# `go run ./cmd/dev` starts missing local Redis via Docker, then runs the API.
# LiveKit Cloud settings pass through unchanged; no local LiveKit is started.
# MySQL/MongoDB still use the configured databases above. See docs/development.md.
# DEV_COMPOSE_PROJECT=livemart-dev

# Optional Nominatim-compatible reverse geocoder. Default: public Nominatim.
# Use a suitable hosted/self-hosted provider for higher traffic.
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
