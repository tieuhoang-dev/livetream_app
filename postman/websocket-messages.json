{
  "description": "Copy payload vào Postman WS. Thay các mã khu vực 0 bằng mã GHN thật trước khi gửi.",
  "seller_url": "{{ws_url}}/api/ws",
  "buyer_url": "{{ws_url}}/api/ws",
  "messages": [
    {
      "case": "WS-001",
      "tab": "guest",
      "payload": {
        "type": "live.create",
        "request_id": "ws-001",
        "payload": {
          "title": "Không được tạo"
        }
      }
    },
    {
      "case": "WS-002",
      "tab": "guest",
      "payload": {
        "type": "authenticate",
        "request_id": "ws-002",
        "payload": {
          "token": "invalid-token"
        }
      }
    },
    {
      "case": "WS-003",
      "tab": "seller",
      "payload": {
        "type": "authenticate",
        "request_id": "ws-003",
        "payload": {
          "token": "{{seller_token}}"
        }
      }
    },
    {
      "case": "WS-003-buyer",
      "tab": "buyer",
      "payload": {
        "type": "authenticate",
        "request_id": "ws-003-buyer",
        "payload": {
          "token": "{{buyer_token}}"
        }
      }
    },
    {
      "case": "WS-004",
      "tab": "guest",
      "payload": {
        "type": "lives.subscribe",
        "request_id": "ws-004",
        "payload": {
          "status": "start",
          "page": 1,
          "page_size": 12
        },
        "subscription_id": "catalog"
      }
    },
    {
      "case": "WS-005",
      "tab": "seller",
      "payload": {
        "type": "live.create",
        "request_id": "ws-005",
        "payload": {
          "title": "Postman live"
        }
      }
    },
    {
      "case": "WS-006",
      "tab": "buyer",
      "payload": {
        "type": "live.subscribe",
        "request_id": "ws-006",
        "payload": {
          "livestream_id": "{{live_id}}",
          "page": 1,
          "page_size": 12
        },
        "subscription_id": "room"
      }
    },
    {
      "case": "WS-007",
      "tab": "buyer",
      "payload": {
        "type": "comments.subscribe",
        "request_id": "ws-007",
        "payload": {
          "livestream_id": "{{live_id}}",
          "after": "0"
        },
        "subscription_id": "comments"
      }
    },
    {
      "case": "WS-008",
      "tab": "buyer",
      "payload": {
        "type": "comments.send",
        "request_id": "ws-008",
        "payload": {
          "livestream_id": "{{live_id}}",
          "content": "Còn hàng không?",
          "sender_id": "{{seller_id}}"
        }
      }
    },
    {
      "case": "WS-009",
      "tab": "buyer",
      "payload": {
        "type": "live.end",
        "request_id": "ws-009",
        "payload": {
          "livestream_id": "{{live_id}}"
        }
      }
    },
    {
      "case": "WS-010",
      "tab": "seller",
      "payload": {
        "type": "live.end",
        "request_id": "ws-010",
        "payload": {
          "livestream_id": "{{live_id}}"
        }
      }
    },
    {
      "case": "WS-011",
      "tab": "buyer",
      "payload": {
        "type": "live.get",
        "request_id": "ws-011",
        "payload": {
          "livestream_id": "{{live_id}}"
        }
      }
    },
    {
      "case": "WS-013",
      "tab": "seller",
      "payload": {
        "type": "shipping.stations.nearby",
        "request_id": "ws-013",
        "payload": {
          "latitude": 21.028511,
          "longitude": 105.804817,
          "carrier_province_id": 0,
          "carrier_district_id": 0
        }
      }
    },
    {
      "case": "WS-014",
      "tab": "seller",
      "payload": {
        "type": "shipping.pickup.save",
        "request_id": "ws-014",
        "payload": {
          "livestream_id": "{{live_id}}",
          "pickup_address": {
            "name": "Shop test",
            "phone": "0901234567",
            "carrier_province_id": 0,
            "carrier_district_id": 0,
            "latitude": 21.028511,
            "longitude": 105.804817,
            "use_nearest_station": true
          }
        }
      }
    },
    {
      "case": "WS-015",
      "tab": "buyer",
      "payload": {
        "type": "orders.subscribe",
        "request_id": "ws-015",
        "payload": {},
        "subscription_id": "orders"
      }
    },
    {
      "case": "WS-018-sub",
      "tab": "buyer",
      "payload": {
        "type": "chat.subscribe",
        "request_id": "ws-018-sub",
        "payload": {},
        "subscription_id": "messages"
      }
    },
    {
      "case": "WS-018-send",
      "tab": "seller",
      "payload": {
        "type": "chat.send",
        "request_id": "ws-018-send",
        "payload": {
          "receiver_id": "{{buyer_id}}",
          "message_type": "text",
          "content": "Tin nhắn riêng",
          "temp_id": "postman-1"
        }
      }
    },
    {
      "case": "WS-020",
      "tab": "seller",
      "payload": {
        "type": "live.logout",
        "request_id": "logout-seller",
        "payload": {}
      }
    },
    {
      "case": "WS-021",
      "tab": "seller",
      "payload": {
        "type": "live.products.create",
        "request_id": "inline-product",
        "payload": {
          "livestream_id": "{{live_id}}",
          "product": {
            "name": "Sản phẩm mới trong live",
            "price": 100000,
            "stock_quantity": 10,
            "image_url": "{{product_image_url}}",
            "parcel": {
              "weight_grams": 500,
              "length_cm": 20,
              "width_cm": 15,
              "height_cm": 10
            }
          },
          "discount_price": 80000,
          "stock_quantity": 5,
          "is_pinned": true
        }
      }
    }
  ]
}
